---
import "../styles/global.css";
import "../styles/fonts.css";
import ThemeSwitcher from "@components/ThemeSwitcher.astro";
import { ClientRouter } from "astro:transitions";
const { pageTitle, class: className } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nadav Spiegelman"
      href={new URL("rss.xml", Astro.site)}
    />
    <title>{pageTitle}</title>

    <ClientRouter />
  </head>
  <body>
    <div class:list={["page-wrapper"]}>
      <div>
        <main class:list={["page-content", "flow", className]}>
          <slot />
        </main>
      </div>

      <div class="footer-container">
        <footer class="wrapper">
          <ThemeSwitcher />

          <a href="/rss.xml">Subscribe (RSS)</a>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .page-wrapper {
    min-height: 100vh;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  header,
  footer {
    display: flex;
    padding: var(--space-xs);
    gap: var(--space-xs);
    font-size: var(--size-step--1);
  }

  .footer-container {
    --border: hsla(from var(--color-border) h s l / 0.5);
    --background: oklch(
      from var(--background-color) calc(l * 95%) c calc(h - 10)
    );

    .dark & {
      --background: oklch(from var(--background-color) calc(l * 85%) c h);
    }

    margin-block-start: var(--space-3xl);
    background-color: var(--background);
    opacity: 0.9;
    border-block-start: var(--border-width-thin) solid var(--border);
  }
</style>
