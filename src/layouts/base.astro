---
import "../styles/global.css";
import "../styles/fonts.css";
import ThemeSwitcher from "@components/ThemeSwitcher.astro";
import { ClientRouter } from "astro:transitions";
import navLinks from "@components/navLinks";
const { pageTitle, class: className } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nadav Spiegelman"
      href={new URL("rss.xml", Astro.site)}
    />
    <title>{pageTitle}</title>

    <ClientRouter />
  </head>
  <body>
    <div class:list={["page-wrapper"]}>
      <header class="site-header | no-measure">
        <nav class="site-nav" aria-label="Main navigation">
          {
            navLinks.map(({ href, text }) => (
              <a
                href={href}
                aria-current={
                  href === `/${Astro.url.pathname.split("/")[1]}` || undefined
                }
              >
                {text}
              </a>
            ))
          }
        </nav>

        <slot name="subnav" />
      </header>

      <div>
        <main class:list={["page-content", className]}>
          <slot name="toc" />
          <slot />
        </main>
      </div>

      <footer class="site-footer no-measure">
        <ThemeSwitcher />

        <a href="/rss.xml">Subscribe (RSS)</a>
      </footer>
    </div>
  </body>
</html>
