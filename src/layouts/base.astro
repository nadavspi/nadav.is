---
import "../styles/global.css";
import "../styles/fonts.css";
import BackTo from "../components/BackTo.astro";
import ThemeSwitcher from "@components/ThemeSwitcher.astro";
const { pageTitle, backTo, noHeader, class: className } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nadav Spiegelman"
      href={new URL("rss.xml", Astro.site)}
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="wrapper">
      <header>
        {!noHeader && <BackTo backTo={backTo} />}
      </header>

      <div class:list={['page-content', className]}>
        <slot />
      </div>

      <footer>
        <ThemeSwitcher />

        <a href="/rss.xml">Subscribe (RSS)</a>
      </footer>
    </div>
  </body>
</html>

<style>
  .wrapper {
    min-height: 100vh;
  }

  header,
  footer {
    display: flex;
    padding: var(--space-xs);
    gap: var(--space-xs);
    font-size: var(--size-step--1);
  }
</style>
