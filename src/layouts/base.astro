---
import "../styles/global.css";
import "../styles/fonts.css";
import BackTo from "../components/BackTo.astro";
import ThemeSwitcher from "@components/ThemeSwitcher.astro";
const { pageTitle, backTo, noHeader, class: className } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nadav Spiegelman"
      href={new URL("rss.xml", Astro.site)}
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-wrapper">
      {
        !noHeader && (
          <div>
            <header class="wrapper">
              <BackTo backTo={backTo} />
            </header>
          </div>
        )
      }

      <div>
        <main class:list={["page-content", "flow", className]}>
          <slot />
        </main>
      </div>

      <div>
        <footer class="wrapper">
          <ThemeSwitcher />

          <a href="/rss.xml">Subscribe (RSS)</a>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .page-wrapper {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  header,
  footer {
    display: flex;
    padding: var(--space-xs);
    gap: var(--space-xs);
    font-size: var(--size-step--1);
  }
</style>
