---
import Grid from "./Grid.astro";
import Prose from "./Prose.astro";

interface Props {
  title: string;
  date: string;
  class?: string;
}

const { title, date } = Astro.props;
const { class: className } = Astro.props;
---

<section class:list={[className]}>
  <Prose imagesHeight="tall">
    <header class="flow">
      <div class="metadata flow">
        <h2>{title}</h2>
        <time>{date}</time>
        <slot name="description" />
      </div>

      <div class="banner">
        <slot name="banner" />
      </div>
    </header>

    <Grid>
      <slot name="images" />
    </Grid>
  </Prose>
</section>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--flow-space);
  }

  .metadata {
    flex: 1 1 max(20em, 40%);
  }

  .banner {
    flex: 0 1 max(400px, 55%);
  }
</style>
