---
import Prose from "./Prose.astro";

interface Props {
  title: string;
  date: string;
  class?: string;
  layout?: "reverse";
}

const { title, date, class: className, layout } = Astro.props;
---

<Prose class={className} imagesHeight="tall">
  <header class="flow">
    {
      layout === "reverse" && (
        <div class="banner">
          <slot name="banner" />
        </div>
      )
    }

    <div class="metadata flow">
      <h2>{title}</h2>
      <time>{date}</time>
      <slot name="description" />
    </div>

    {
      layout !== "reverse" && (
        <div class="banner">
          <slot name="banner" />
        </div>
      )
    }
  </header>
</Prose>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  .metadata {
    flex: 1 1 max(20em, 40%);
  }

  .banner {
    flex: 0 1 max(400px, 55%);
  }
</style>
