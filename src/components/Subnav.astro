---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="subnav flow">
  <summary>{title}</summary>
  <slot />
</details>

<script>
  import maybeOpen from "../lib/maybeOpen";

  const init = () => {
    maybeOpen("(width > 1200px)", ".subnav");

    const link = document.querySelector(`.subnav .active`);
    if (link) {
      link.scrollIntoView({ block: "start" });
    }
  };

  init();
  document.addEventListener("astro:after-swap", init);
</script>
