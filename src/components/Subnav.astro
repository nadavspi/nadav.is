---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="subnav flow">
  <summary>{title}</summary>
  <slot />
</details>

<script>
  import maybeOpen from "../lib/maybeOpen";

  const init = () => {
    maybeOpen("(width > 1200px)", ".subnav");

    const subnav = document.querySelector(".subnav");
    const link = document.querySelector(`.subnav [aria-current]`);
    // @ts-ignore
    if (subnav.scrollHeight > subnav.clientHeight && link) {
      link.scrollIntoView({ block: "start" });
    }
  };

  init();
  document.addEventListener("astro:after-swap", init);
</script>
