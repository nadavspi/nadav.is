---
import type { BlockMarkdown } from "src/types/directus-schema";

const block: BlockMarkdown = Astro.props.block;
import rehypeShiki from "@shikijs/rehype";
import rehypeStringify from "rehype-stringify";
import remarkDirective from "remark-directive";
import remarkParse from "remark-parse";
import remarkRehype from "remark-rehype";
import type { Root } from "mdast";
import { h } from "hastscript";
import { unified } from "unified";
import { visit } from "unist-util-visit";

const containerDirectives = () => (tree: Root) =>
  visit(tree, (node) => {
    if (node.type === "containerDirective") {
      const allowed = ["aside", "details"];
      if (!allowed.includes(node.name)) return;
    } else if (node.type === "leafDirective") {
      const allowed = ["summary"];
      if (!allowed.includes(node.name)) return;
    } else {
      return;
    }

    const tagName = node.name;
    const data = node.data || (node.data = {});
    data.hName = tagName;
    data.hProperties = h(tagName, node.attributes || {}).properties;
  });

const html = await unified()
  .use(remarkParse)
  .use(remarkDirective)
  .use(containerDirectives)
  .use(remarkRehype)
  .use(rehypeShiki, {
    themes: {
      light: "rose-pine-dawn",
      dark: "catppuccin-mocha",
    },
  })
  .use(rehypeStringify)
  .process(block.content);
---

<div data-id={block.id} set:html={html} />
