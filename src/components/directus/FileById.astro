---
import { getEntry } from "astro:content";

import DirectusFileRenderer from "./DirectusFileRenderer.astro";

interface Props {
  galleryId?: string;
  id: string;
}

const { galleryId, id } = Astro.props;
const file = await getEntry("files", id);
---

{file && <DirectusFileRenderer file={file} galleryId={galleryId} />}
