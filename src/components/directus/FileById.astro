---
import { getEntry } from "astro:content";

import DirectusFileRenderer from "./DirectusFileRenderer.astro";

interface Props {
  disableLightbox?: boolean;
  galleryId?: string;
  id: string;
}

const { galleryId, id, disableLightbox } = Astro.props;
const file = await getEntry("files", id);
---

{file && <DirectusFileRenderer file={file} galleryId={galleryId} disableLightbox={disableLightbox} />}
