---
import { getEntry } from "astro:content";

import DirectusImage from "./DirectusImage.astro";

interface Props {
  disableLightbox?: boolean;
  galleryId?: string;
  id: string;
}

const { galleryId, id, disableLightbox } = Astro.props;
const file = await getEntry("files", id);

const hasChildren = Astro.slots.has("default");
---


{
  file && (
    <DirectusImage
      file={file}
      galleryId={galleryId}
      disableLightbox={disableLightbox}
    >
      <slot slot={hasChildren && "content"} />
    </DirectusImage>
  )
}
