---
interface Props {
  disableLightbox?: boolean;
  file: object;
  galleryId?: string;
  showCaptions?: boolean;
}

import { Image } from "astro:assets";
const { disableLightbox, galleryId, file, showCaptions } = Astro.props;

import "@fancyapps/ui/dist/fancybox/fancybox.css";
import type { DirectusFile } from "src/types/directus-schema";

const image = {
  // depends on whether the file is from the content collection
  // or from a directus block
  // @ts-ignore
  ...(file.data ?? file),
  // @ts-ignore
  src: `${import.meta.env.DIRECTUS_URL}/assets/${file.id}`,
} as DirectusFile & { src: string };

const Wrapper = showCaptions ? "figure" : Fragment;
---

{
  disableLightbox && image && image.width && image.height && (
    <Image
      alt={image.title || ""}
      height={image.height}
      src={image.src}
      width={image.width}
    />
  )
}

{
  !disableLightbox && image && image.width && image.height && (
    <a
      data-fancybox={galleryId || "gallery"}
      href={image.src}
      class="focus-outline"
      style={`--width: ${image.width}; --height: ${image.height};`}
    >
      <slot name="content">
        <Wrapper>
          <Image
            alt={image.title || ""}
            height={image.height}
            src={image.src}
            width={image.width}
          />
          {showCaptions && <figcaption>{image.caption}</figcaption>}
        </Wrapper>
      </slot>
    </a>
  )
}

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";
  const bind = () => {
    const isDarkMode = document
      .querySelector("html")
      ?.classList.contains("dark");

    Fancybox.bind("[data-fancybox]", {
      Carousel: {
        Arrows: false,
        Autoplay: {
          timeout: "5000",
        },
        Thumbs: {
          type: "classic",
        },
        Toolbar: {
          absolute: false,
          display: {
            left: ["counter"],
            middle: [],
            right: ["fullscreen", "thumbs", "autoplay", "close"],
          },
        },
      },
      mainStyle: {
        "--f-thumb-border-radius": "0",
        "--f-thumb-selected-border":
          "var(--border-width-thin) solid var(--border)",
        "--f-thumb-selected-shadow": "none",
      },
      theme: isDarkMode ? "dark" : "light",
    });
  };

  const unbind = () => {
    Fancybox.unbind("[data-fancybox]");
  };

  document.addEventListener("theme-switch", () => {
    unbind();
    bind();
  });
  document.addEventListener("astro:page-load", () => {
    bind();
  });
</script>

<style is:global>
  .f-thumbs__slide:not(.is-selected) {
    opacity: 0.7;
  }

  .f-thumbs__slide button::after {
    inset: -3px;
  }
</style>

<style>
  a {
    text-decoration: none;

    &:hover,
    &:focus-visible,
    &:active {
      color: inherit;
    }
  }

  figure {
    display: grid;
    grid-template: "container";
    place-items: center;
    place-content: center;
  }

  figure > * {
    grid-area: container;
  }

  figcaption {
    place-self: end right;
    border-block-end: none;
    margin: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    font-family: var(--sans);
    background-color: oklch(from var(--background) l c h / 80%);
  }
</style>
