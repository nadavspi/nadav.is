---
interface Item {
  href: string;
  caption: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { items, title } = Astro.props;
---

<div class="toc">
  <h2>{title}</h2>
  <ol>
    {
      items.map(({ caption, href }) => (
        <li>
          <a href={href}>{caption}</a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .toc {
    --flow-space: var(--space-xl);
  }
</style>
