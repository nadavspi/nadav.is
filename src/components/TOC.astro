---
export interface TocItem {
  href: string;
  caption: string;
}

interface Props {
  title?: string;
  items: TocItem[];
}

const { items } = Astro.props;
const title = Astro.props.title || "Table of contents";
---

<details class="toc | small">
  <summary>{title}</summary>
  <ol>
    {
      items.map(({ caption, href }) => (
        <li>
          <a href={href}>{caption}</a>
        </li>
      ))
    }
  </ol>
</details>

<script>
  const maybeOpen = () => {
    let shouldOpen = window.matchMedia("(width > 1400px)");
    shouldOpen.addEventListener("change", maybeOpen);

    if (shouldOpen.matches) {
      document.querySelector(".toc")?.setAttribute("open", "true");
    } else {
      document.querySelector(".toc")?.removeAttribute("open");
    }
  };

  const setActive = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const link = document.querySelector(`.toc a[href="#${id}"]`);
        if (!link) {
          return;
        }

        if (entry.intersectionRatio > 0) {
          link.parentElement?.classList.add("active");
        } else {
          link.parentElement?.classList.remove("active");
        }
      });
    });

    document.querySelectorAll("section[id]").forEach((section) => {
      observer.observe(section);
    });
  };

  const init = () => {
    maybeOpen();
    setActive();
  };

  init();
  document.addEventListener("astro:after-swap", init);
</script>
