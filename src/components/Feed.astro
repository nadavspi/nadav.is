---
interface Props {
  id: string;
}

import "../styles/blocks/feed.css";

import FileById from "./directus/FileById.astro";
import { getEntry } from "astro:content";
import type { PhotoGallery } from "src/types/directus-schema";
const { id } = Astro.props;

const gallery = await getEntry("photoGalleries", id);
const data = gallery?.data as PhotoGallery;
import { makeHref } from "src/lib/slugs";
const href = makeHref('photoGalleries', data.slug);

// @ts-ignore
const isFeatured = data.options.includes("featured");
---

<div class="feed-container">
  <h3 class:list={[{ featured: isFeatured }]}>
    <a href={href}>{data.title}</a>
  </h3>
  <ol class="feed | no-measure">
    {
      data.files.map((file) => (
        <li>
          <FileById galleryId={data.title} id={file.directus_files_id} />
        </li>
      ))
    }
  </ol>
</div>
