---
import { Masonry } from "astro-masonry";

const { fullbleed } = Astro.props;
---

<Masonry
  breakpointCols={{
    default:  fullbleed ? 3 : 2,
    1280: 2,
    768: 1,
  }}
  class:list={["masonry | grid", { "full-bleed": fullbleed }, Astro.props.class]}
  columnClass="grid"
>
  <slot />
</Masonry>
