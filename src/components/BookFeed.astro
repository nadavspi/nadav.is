---
interface Props {
  books: Book[];
  class?: string;
}

import type { Book } from "src/types/directus-schema";
import FileById from "./directus/FileById.astro";

import "../styles/blocks/feed.css";

const { books } = Astro.props;
---

<ol class:list={["feed | no-measure", Astro.props.class]}>
  {
    books.map((book) => {
      return (
        <li>
          <details class="book" name="book">
            <summary>
            </summary>
            <div class="book-details">
              {book.title} by {book.author}
            </div>
          </details>
        </li>
      );
    })
  }
</ol>

<style>
  .book {
    &:open {
      outline: var(--border-width-thin) solid var(--color-border);
    }
  }

  .book-details {
    padding: var(--space-s);
  }
</style>
