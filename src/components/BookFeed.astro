---
interface Props {
  books: Book[];
  class?: string;
  noDetails?: boolean;
}

import plur from "plur";

import type { Book } from "src/types/directus-schema";
import FileById from "./directus/FileById.astro";

import "../styles/blocks/feed.css";
import { makeHref } from "src/lib/slugs";

const { books, noDetails } = Astro.props;
---

<ol class:list={["feed | no-measure", Astro.props.class]}>
  {
    books.map((book) => {
      return (
        <li>
          {book.cover && (
            <a href={makeHref("books", book.slug)}>
              <FileById
                id={book.cover as string}
                galleryId="books"
                disableLightbox
              />
            </a>
          )}

          {!noDetails && (
            <details class="book-info" name="book">
              <div class="flow">
                <header>
                  <div>{book.title}</div>
                  {book.author}
                </header>

                <div>
                  {book.highlights?.length}{" "}
                  {plur("highlight", book.highlights?.length)}
                </div>
              </div>
            </details>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .book-info {
    position: relative;
    padding: var(--space-2xs);
    font-size: var(--size-step--1);
    cursor: pointer;

    &:open {
      position: absolute;
      background-color: var(--background-color);
      outline: var(--border-width-thin) solid var(--color-border);
      z-index: 1;
    }
  }
</style>
