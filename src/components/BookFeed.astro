---
import type { Book } from "src/types/directus-schema";
import FileById from "./directus/FileById.astro";

const books = Astro.props.books.map((book) => book.data) as Book[];
---

<ol class="books-list | feed">
  {
    books.map((book) => {
      return (
        <li>
          <details class="book" name="book">
            <summary>
              {book.cover && (
                <FileById id={book.cover as string} galleryId="books" disableLightbox />
              )}
            </summary>
            <div class="book-details">
              {book.title} by {book.author}
            </div>
          </details>
        </li>
      );
    })
  }
</ol>

<style>
  .book {

    &:open {
      outline: var(--border-width-thin) solid var(--color-border);
    }
  }

  .book-details {
    padding: var(--space-s);
  }
</style>
