---
interface Props {
  id: string;
}

import type { PhotoGallery } from "src/types/directus-schema";

import { getEntry } from "astro:content";

import FileById from "./directus/FileById.astro";
const { id } = Astro.props;

const gallery = await getEntry("photoGalleries", id);
const data = gallery?.data as PhotoGallery;
---

<section class="photo-grid">
  {
    data.files.map((file) => (
      <FileById galleryId={data.title} id={file.directus_files_id} />
    ))
  }
</section>

<style>
  .photo-grid {
    --min-height: clamp(300px, 20vw, 400px);

    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    padding: var(--space-m);
    max-inline-size: 80em;
    margin-inline: auto;

    a {
      flex-grow: calc(var(--width) * (100000 / var(--height)));
      flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
      aspect-ratio: var(--width) / var(--height);
    }
  }
</style>
