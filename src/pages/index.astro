---
import Layout from "@layouts/base.astro";
import Nadav from "../content/photos/nadav-closet.jpg";
import { Image } from "astro:assets";
import navLinks from "@components/navLinks.js";

import { getCollection } from "astro:content";
import Item from "./notes/_item.astro";

const writing = await getCollection("writing");
const media = await getCollection("media");
const notes = await getCollection("notes");
const items = [...writing, ...media, ...notes].sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);

import "../styles/home.css";
---

<Layout noHeader={true} pageTitle="Nadav Spiegelman’s website">
  <section class="hello">
    <h1>Hello. I’m Nadav Spiegelman and this is my home on the web.</h1>
  </section>
</Layout>

<style>
  .hello {
    position: relative;
    display: flex;
    justify-content: center;
    padding-inline: var(--space-s);

    &::after {
      content: "";
      width: 100%;
      position: absolute;
      top: 50%;
      height: 0;
      border-top: var(--border-width-thick) solid;
      transform: translatey(-50%);
    }
  }

  h1 {
    max-width: 16em;
    padding: var(--space-l);
    line-height: 1.6;
    border: var(--border-width-thick) solid;
    background-color: var(--background-color);
    z-index: 1;
  }
</style>
