---
import Layout from "@layouts/base.astro";
import { getCollection } from "astro:content";

const writing = await getCollection("writing");
const media = await getCollection("media");
const notes = await getCollection("notes");
const items = [...writing, ...media, ...notes].sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);

const galleries = [...(await getCollection("photoGalleries"))].sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
const featuredGalleries = galleries.filter((gallery) =>
  gallery.data.options?.includes("featured"),
);
const latestGalleries = galleries.filter(
  (gallery) => !gallery.data.options?.includes("featured"),
  ).slice(0, 2);

const jobYears = new Date().getFullYear() - 2014;

import "../styles/home.css";
import Feed from "@components/Feed.astro";
import Items from "./notes/_items.astro";
import { makeHref } from "src/lib/slugs";
---

<Layout noHeader={true} pageTitle="Nadav Spiegelman’s website">
  <div class="flow">
    <section class="tile">
      <h1>Hello. I’m Nadav Spiegelman and this is my home on the web.</h1>
    </section>
    <article class="flow center">
      <p>
        I made <a href="/notes/my-first-website">my first website</a> when I was
        10 years old and haven't stopped. For the past {jobYears} years, I've also
        been making them professionally as a front end developer, but I don't want
        to talk about that here.
      </p>
      <p>
        This website is for photos and for writing about my interests, which
        include art, food, books, code, justice.
      </p>
    </article>

    <section class="tile">
      <div class="photos">
        <a href={makeHref("photoGalleries")}><h2>Photography</h2></a>

        <div class="feeds | flow-large">
          <div class="feed-group | flow">
            <h4>Featured</h4>
            {featuredGalleries.map((gallery) => <Feed id={gallery.id} />)}
          </div>

          <div class="feed-group | flow">
            <h4>Latest</h4>

            {latestGalleries.map((gallery) => <Feed id={gallery.id} />)}
          </div>

          <a class="view-all" href={makeHref("photoGalleries")}
            >View all photo galleries →</a
          >
        </div>
      </div>
    </section>

    <section class="tile">
      <div class="notes | flow" transition:name="notes">
        <a href="/notes"><h2>Notes</h2></a>

        <div>
          <h4>Latest</h4>
          <Items items={items.slice(0, 5)} />

          <a class="view-all" href={makeHref("notes")}>View all notes →</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  h1 {
    max-width: 16em;
    line-height: 1.6;

    @media (min-width: 500px) {
      margin-inline-end: 20%;
    }
  }

  article {
    padding: var(--space-l);
  }

  .tile:has(.photos) {
    --top-offset: 10%;
  }

  .photos {
    --flow-space: var(--space-xl);

    padding-inline: var(--space-xl);

    @media (min-width: 1000px) {
      margin-inline-start: 5%;
    }

    h2 {
      margin-block-end: var(--space-l);
    }

    img {
      width: auto;
      height: min(38vw, 200px);
    }

    .flow {
      --flow-space: var(--flow-space--default);
    }
  }

  h4 {
    font-family: sans-serif;
    font-weight: normal;
    opacity: 0.8;
    text-transform: uppercase;
    font-size: var(--size-step--1);
    letter-spacing: 0.03em;
  }

  .view-all {
    display: inline-block;
    margin-block-start: var(--space-m);
  }
</style>
