<style>
  .tile {
    position: relative;
    display: flex;
    margin-block: var(--space-2xl);
    justify-content: center;
    padding-inline: var(--space-s);

    &::after {
      content: "";
      width: 100%;
      position: absolute;
      top: 50%;
      height: 0;
      border-top: var(--border-width-thick) solid;
      transform: translatey(-50%);
      opacity: 0.5;
    }

    > :first-child {
      padding: var(--space-l);
      border: var(--border-width-thick) solid;
      background-color: var(--background-color);
      z-index: 1;
    }
  }

  h1 {
    max-width: 16em;
    margin-inline-end: 20%;
    line-height: 1.6;
  }

  article {
    padding: var(--space-l);
  }

  .feed {
    display: flex;
    list-style: none;
    margin: 0;
    padding: var(--space-xs) 0;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  li {
    flex-shrink: 0;
  }

  .photos {
    --flow-space: var(--space-xl);
    margin-inline-start: 5%;

    h2 {
      margin-block-end: var(--space-l);
    }

    img {
      width: auto;
      height: 100px;
    }

    .flow {
      --flow-space: var(--flow-space--default);
    }
  }

  .tile .photos {
    padding-inline: var(--space-xl);
  }

  .featured {
    position: relative;

    &::before {
      position: absolute;
      left: -1.2em;
      content: "✰";
      font-weight: normal;
    }
  }
</style>
