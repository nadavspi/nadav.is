---
import Layout from "@layouts/base.astro";
import { getCollection } from "astro:content";

const writing = await getCollection("writing");
const media = await getCollection("media");
const notes = await getCollection("notes");
const items = [...writing, ...media, ...notes].sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);

const jobYears = new Date().getFullYear() - 2014;

import { Image } from "astro:assets";
import Fine029 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_029.jpg";
import Fine030 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_030.jpg";
import Fine031 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_031.jpg";
import Fine032 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_032.jpg";
import Fine033 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_033.jpg";
import Fine034 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_034.jpg";
import Fine035 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_035.jpg";
import Fine036 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_036.jpg";
import Fine037 from "./photography/everything-is-fine/_everything is fine_Nadav Spiegelman_037.jpg";

import "../styles/home.css";
---

<Layout noHeader={true} pageTitle="Nadav Spiegelman’s website">
  <div class="flow">
    <section class="tile">
      <h1>Hello. I’m Nadav Spiegelman and this is my home on the web.</h1>
    </section>
    <article class="flow center">
      <p>
        I made <a href="/notes/my-first-website">my first website</a> when I was
        10 years old and haven't stopped. For the past {jobYears} years, I've also
        been making them professionally as a front end developer, but I don't want
        to talk about that here.
      </p>
      <p>
        This website is for photos and for writing about my interests, which
        include art, food, books, code, justice.
      </p>
    </article>

    <section class="tile">
      <div class="photos | flow">
        <h2>Photography</h2>

        <div class="flow">
          <h4>Featured</h4>
          <div>
            <h3 class="featured">Everything is fine</h3>
            <ol class="feed | no-measure">
              <li>
                <Image src={Fine029} alt="" />
              </li>
              <li>
                <Image src={Fine030} alt="" />
              </li>
              <li>
                <Image src={Fine031} alt="" />
              </li>
              <li>
                <Image src={Fine032} alt="" />
              </li>
              <li>
                <Image src={Fine033} alt="" />
              </li>
              <li>
                <Image src={Fine034} alt="" />
              </li>
              <li>
                <Image src={Fine035} alt="" />
              </li>
              <li>
                <Image src={Fine036} alt="" />
              </li>
              <li>
                <Image src={Fine037} alt="" />
              </li>
            </ol>
          </div>

          <div>
            <h3 class="featured">Artists</h3>
            <ol class="feed | no-measure">
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
            </ol>
          </div>
        </div>

        <div class="flow">
          <h4>Latest</h4>

          <div>
            <h3>Fourteen days ago</h3>
            <ol class="feed | no-measure">
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
            </ol>
          </div>

          <div>
            <h3>Something that happened</h3>
            <ol class="feed | no-measure">
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
              <li>
                <img src="https://placehold.co/600x400" alt="" />
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .tile {
    --top-offset: 50%;
    --background-color: #fdf5eb;

    /* 50% opacity of var(--text-color) */
    --border-color: #958278;

    .dark & {
      --background-color: #221b31;

      /* 50% opacity of var(--text-color) */
      --border-color: #777581;
    }

    position: relative;
    display: flex;
    margin-block: var(--space-2xl);
    justify-content: center;
    padding-inline: var(--space-s);

    &::after {
      content: "";
      width: 100%;
      position: absolute;
      top: var(--top-offset);
      height: 0;
      border-top: var(--border-width-thick) solid var(--border-color);
      transform: translatey(-50%);
    }

    > :first-child {
      padding: var(--space-l);
      border: var(--border-width-thick) solid var(--border-color);
      background-color: var(--background-color);
      z-index: 1;
    }
  }

  h1 {
    max-width: 16em;
    line-height: 1.6;

    @media (min-width: 500px) {
      margin-inline-end: 20%;
    }
  }

  article {
    padding: var(--space-l);
  }

  .feed {
    display: flex;
    list-style: none;
    margin: 0;
    padding: var(--space-xs) 0;
    gap: var(--space-2xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  li {
    flex-shrink: 0;
  }

  .tile:has(.photos) {
    --top-offset: 10%;
  }

  .photos {
    --flow-space: var(--space-xl);

    @media (min-width: 500px) {
      margin-inline-start: 5%;
    }

    h2 {
      margin-block-end: var(--space-l);
    }

    img {
      width: auto;
      height: min(30vw, 280px);
    }

    .flow {
      --flow-space: var(--flow-space--default);
    }
  }

  .tile .photos {
    padding-inline: var(--space-xl);
  }

  .featured {
    position: relative;

    &::before {
      position: absolute;
      left: -1.2em;
      content: "✰";
      font-weight: normal;
    }
  }

  h4 {
    font-family: sans-serif;
    font-weight: normal;
    opacity: 0.8;
    text-transform: uppercase;
    font-size: 0.7em;
    letter-spacing: 0.03em;

    + * {
      --flow-space: var(--space-3xs);
    }
  }
</style>
