---
interface Props {
  book: Book;
}

import Layout from "@layouts/base.astro";
import plur from "plur";
import { getCollection } from "astro:content";
import type { Book } from "src/types/directus-schema";
import FileById from "@components/directus/FileById.astro";
import WrittenLongAgo from "@components/WrittenLongAgo.astro";
import { makeHref } from "src/lib/slugs";

export async function getStaticPaths() {
  const items = await getCollection("books");
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { book: item.data },
  }));
}

const { book } = Astro.props;
const { title, author, highlights, cover } = book;

const books = (await getCollection("books"))
  .filter((book) => book.data.cover)
  .map((book) => book.data);

const booksByYear: { [year: string]: Book[] } = {};

for (const book of books) {
  const year = new Date(book.date_created).getFullYear().toString();

  if (!booksByYear[year]) {
    booksByYear[year] = [];
  }

  booksByYear[year].push(book);
}

for (const year of Object.keys(booksByYear)) {
  booksByYear[year].sort(
    (a, b) => Date.parse(b.date_created) - Date.parse(a.date_created),
  );
}

const sortedYears = Object.keys(booksByYear).sort(
  (a, b) => Number(b) - Number(a),
);
---

<Layout pageTitle={title}>
  <details slot="subnav" class="subnav flow">
    <summary>Other books</summary>
    <div class="flow">
      {
        sortedYears.map((year) => (
          <section>
            <h3>{year}</h3>
            <ol class="flow" role="list">
              {booksByYear[year].map((book) => (
                <li>
                  <a href={makeHref("books", book.slug)}>
                    <div>{book.title}</div>
                    <div class="small">{book.author}</div>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </details>

  <div class="tile" transition:name="reading">
    <header class="flow">
      <div>
        <h1>{title}</h1>
        by {author}
      </div>
      <p class="h4">
        Created: <WrittenLongAgo date={book.date_created} />
      </p>
    </header>
    {
      book.cover && (
        <div class="prose">
          <FileById id={book.cover as string} disableLightbox />
        </div>
      )
    }
  </div>

  <article class="flow-large">
    <h2>My {highlights.length} {plur("highlight", highlights.length)}</h2>
    <ul class="highlights | flow-large" role="list">
      {
        highlights.map((highlight) => (
          <li class="flow-small">
            <blockquote>{highlight.content}</blockquote>
            {highlight.note && (
              <aside class="small">Reader's note: {highlight.note}</aside>
            )}
          </li>
        ))
      }
    </ul>
  </article>
</Layout>

<style>
  header {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<script>
  import maybeOpen from "../../lib/maybeOpen";

  const init = () => {
    maybeOpen("(width > 1200px)", ".subnav");

    const link = document.querySelector(`.subnav .active`);
    if (link) {
      link.scrollIntoView({ block: "start" });
    }
  };

  init();
  document.addEventListener("astro:after-swap", init);
</script>
