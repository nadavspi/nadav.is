---
import WrittenLongAgo from "@components/WrittenLongAgo.astro";
import Layout from "@layouts/base.astro";
import Prose from "@components/Prose.astro";
import { getCollection } from "astro:content";
import DirectusBlocks from "@components/DirectusBlocks.astro";
import Content from "@components/Content.astro";
import Items from "./_items.astro";
import Subnav from "@components/Subnav.astro";

export async function getStaticPaths() {
  const writing = await getCollection("writing");
  const notes = await getCollection("notes");
  return [
    ...writing.map((item) => ({
      params: { slug: item.slug },
      props: { item, source: "astro" },
    })),
    ...notes.map((item) => ({
      params: { slug: item.data.slug },
      props: { item, source: "directus" },
    })),
  ];
}

const { item, source } = Astro.props;
const { date, title, subtitle, tags } = item.data;

const writing = await getCollection("writing");
const media = await getCollection("media");
const notes = await getCollection("notes");
const items = [...writing, ...media, ...notes].sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
---

<Layout backTo="notes" pageTitle={title}>
  <Subnav slot="subnav" title="Other notes">
    <div class="flow">
      <Items items={items} />
    </div>
  </Subnav>

  <div class="tile" transition:name="notes">
    <header class="flow">
      {
        tags && source === "directus" && (
          <div class="small">{tags[0].tags_id.title}</div>
        )
      }

      <h1>{title}</h1>
      {subtitle}
      <WrittenLongAgo date={date} server:defer>Loading...</WrittenLongAgo>
    </header>
  </div>

  <Prose>
    <article class="flow">
      {source === "astro" && <Content item={item} />}
      {source === "directus" && <DirectusBlocks item={item} />}
    </article>
  </Prose>
</Layout>
